---
---
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-label="Cookie consent">
  <div class="cb-inner">
    <div class="cb-text">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <p>
        We use cookies to serve ads and analyse traffic.
        See our <a href="/privacy/">Privacy Policy</a> for details.
        <span class="cb-current" id="cb-current" hidden></span>
      </p>
    </div>
    <div class="cb-actions">
      <button type="button" class="cb-decline" id="cb-decline">Decline</button>
      <button type="button" class="cb-accept"  id="cb-accept">Accept all</button>
      <button type="button" class="cb-close" id="cb-close" aria-label="Close without changing your choice" hidden>&times;</button>
    </div>
  </div>
</div>

<script>
  /**
   * Consent has to be as easy to withdraw as it was to give, so this banner is
   * reopenable: anything carrying `data-cookie-settings` (the footer link) puts
   * it back on screen, showing the choice currently stored and letting the
   * visitor change it or close without changing anything.
   *
   * Deliberately still one choice rather than per-purpose toggles. There is
   * exactly one processing purpose on this site today — advertising — and no
   * analytics product runs at all, so an "analytics" switch would be a control
   * that does nothing. Splitting it is a change to make alongside a real
   * consent-management platform, not before one.
   */
  const COOKIE_KEY = 'swa_consent';
  const banner  = document.getElementById('cookie-banner')!;
  const current = document.getElementById('cb-current')!;
  const closeBtn = document.getElementById('cb-close')!;

  type Consent = 'granted' | 'denied';

  function getConsent(): Consent | null {
    const stored = localStorage.getItem(COOKIE_KEY);
    return stored === 'granted' || stored === 'denied' ? stored : null;
  }

  function applyConsent(value: Consent) {
    if (typeof (window as any).gtag !== 'function') return;
    (window as any).gtag('consent', 'update', {
      ad_storage:         value,
      analytics_storage:  value,
      ad_user_data:       value,
      ad_personalization: value,
    });
  }

  function hide() {
    banner.style.display = 'none';
  }

  function show() {
    const stored = getConsent();
    // Reopened after a choice: say what the choice is, and offer a way out that
    // does not force the visitor to pick again.
    const reopened = stored !== null;
    current.textContent = stored === 'granted'
      ? ' Your current choice: advertising cookies accepted.'
      : ' Your current choice: advertising cookies declined.';
    current.hidden = !reopened;
    closeBtn.hidden = !reopened;
    banner.style.display = 'block';
  }

  function setConsent(value: Consent) {
    localStorage.setItem(COOKIE_KEY, value);
    applyConsent(value);
    hide();
  }

  if (!getConsent()) show();

  document.getElementById('cb-accept')?.addEventListener('click',  () => setConsent('granted'));
  document.getElementById('cb-decline')?.addEventListener('click', () => setConsent('denied'));
  closeBtn.addEventListener('click', hide);

  // Delegated, so any page can offer the entry point without importing anything.
  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement | null)?.closest('[data-cookie-settings]');
    if (!trigger) return;
    event.preventDefault();
    show();
  });
</script>

<style>
.cookie-banner {
  display: none; /* shown by JS when no consent stored */
  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
  z-index: 9999;
  width: calc(100% - 40px); max-width: 760px;
  background: #1a1a2e;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 16px;
  padding: 16px 20px;
  box-shadow: 0 8px 40px rgba(0,0,0,0.35);
  font-family: 'Inter', sans-serif;
  animation: slideUp 0.3s cubic-bezier(.4,0,.2,1) both;
}
/* Light mode: use a white banner */
:root:not([data-theme="dark"]) .cookie-banner {
  background: #ffffff;
  border: 1px solid #e4edf8;
  box-shadow: 0 8px 40px rgba(0,0,0,0.14);
}
:root:not([data-theme="dark"]) .cb-text { color: #475569; }
:root:not([data-theme="dark"]) .cb-text svg { color: #1a73e8; }
:root:not([data-theme="dark"]) .cb-text a { color: #1a73e8; }
:root:not([data-theme="dark"]) .cb-decline {
  color: #64748b; border-color: #e0e7ef; background: transparent;
}
:root:not([data-theme="dark"]) .cb-decline:hover { background: #f1f5fb; }
@keyframes slideUp {
  from { opacity: 0; transform: translateX(-50%) translateY(16px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}

.cb-inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; flex-wrap: wrap;
}

.cb-text {
  display: flex; align-items: center; gap: 10px;
  color: rgba(255,255,255,0.8); font-size: 0.84rem; line-height: 1.5; flex: 1;
}
.cb-text svg { flex-shrink: 0; color: #60a5fa; }
.cb-text p   { margin: 0; }
.cb-text a   { color: #60a5fa; text-decoration: underline; text-underline-offset: 2px; }
.cb-text a:hover { color: #93c5fd; }

/* A plain `display: block` would beat the UA rule for [hidden]. */
.cb-current:not([hidden]) { display: block; margin-top: 4px; font-weight: 600; opacity: .85; }

.cb-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.cb-close {
  background: transparent; border: none; cursor: pointer;
  color: rgba(255,255,255,0.5); font-size: 1.25rem; line-height: 1;
  padding: 4px 8px; border-radius: 8px;
}
.cb-close:hover { color: white; }
:root:not([data-theme="dark"]) .cb-close { color: #94a3b8; }
:root:not([data-theme="dark"]) .cb-close:hover { color: #0f172a; }
.cb-decline {
  background: transparent; color: rgba(255,255,255,0.55);
  border: 1px solid rgba(255,255,255,0.2);
  padding: 8px 18px; border-radius: 20px;
  font-size: 0.82rem; font-weight: 500; cursor: pointer;
  font-family: 'Inter', sans-serif;
  transition: border-color 0.15s, color 0.15s;
}
.cb-decline:hover { border-color: rgba(255,255,255,0.4); color: white; }
.cb-accept {
  background: #1a73e8; color: white;
  border: none; padding: 8px 20px; border-radius: 20px;
  font-size: 0.82rem; font-weight: 600; cursor: pointer;
  font-family: 'Inter', sans-serif;
  box-shadow: 0 2px 8px rgba(26,115,232,0.4);
  transition: background 0.15s, transform 0.1s;
}
.cb-accept:hover  { background: #1557b0; }
.cb-accept:active { transform: scale(0.97); }

@media (max-width: 540px) {
  .cb-inner { flex-direction: column; align-items: stretch; }
  .cb-actions { justify-content: flex-end; }
}
</style>
