---
/**
 * ToolLayout — minimal layout for each tool page.
 * Usage:
 *   <ToolLayout name="JSON Formatter" category="Developer Tools" status="live" slug="json-formatter">
 *     <!-- your tool UI here -->
 *   </ToolLayout>
 *
 * Props:
 *   name       — display name of the tool
 *   category   — category label (e.g. "Developer Tools")
 *   status     — "live"
 *   slug       — used for the canonical URL
 *   disclaimer — optional short warning shown in the strip
 *   fullWidth  — if true, no max-width wrapper (for tools that need full width)
 */
import Header from "../site/Header.astro";
import Footer from "../site/Footer.astro";
import CookieBanner from "../site/CookieBanner.astro";
import AdSenseHead from "../site/AdSenseHead.astro";
import AdSlot from "../site/AdSlot.astro";
import ConsentMode from "../site/ConsentMode.astro";
import ContentInfoLink from "../tools/ContentInfoLink.astro";
import ExpandedFaq from "../apps/ExpandedFaq.astro";
import ExpandedContent from "../apps/ExpandedContent.astro";
import { siteConfig } from "@/lib/site";
import { canonicalUrl as toCanonicalUrl } from "@/lib/urls";
import { isIndexable } from "@/data/indexing";
import type { AppContent, AppFaq, AppLayout, AppLayoutRail, AppLayoutWidth, AppStatus } from "@smallwebapps/data";
import "../../styles/global.css";

interface Props {
  name: string;
  category: string;
  status: AppStatus;
  slug: string;
  disclaimer?: string;
  fullWidth?: boolean;
  /** Stage layout; omitted leaves the tool's own root wrapper in charge. */
  layout?: AppLayout;
  layoutWidth?: AppLayoutWidth;
  layoutRail?: AppLayoutRail;
  layoutRailFirst?: boolean;
  seoTitle?: string;
  seoDescription?: string;
  /** Visible intro paragraph under the H1 (usually the app's longDescription). */
  description?: string;
  features?: string[];
  faq?: AppFaq[];
  faqExpanded?: AppFaq[];
  content?: AppContent;
}

const {
  name,
  category,
  status,
  slug,
  disclaimer,
  fullWidth = false,
  layout,
  layoutWidth,
  layoutRail,
  layoutRailFirst = false,
  seoTitle,
  seoDescription,
  description,
  features = [],
  faq = [],
  faqExpanded = [],
  content,
} = Astro.props;

const pageTitle    = seoTitle    ?? `${name} — ${siteConfig.name}`;
const pageDesc     = seoDescription ?? `Free browser-based ${name.toLowerCase()} tool. No uploads, no accounts.`;
const canonicalUrl = toCanonicalUrl(`/apps/${slug}`);
const ogImageUrl   = new URL(`/og/${slug}.png`, siteConfig.siteUrl).toString();
const isLive       = status === "live";
const indexable    = isIndexable(slug);
const displayFaq   = faqExpanded.length ? faqExpanded : faq;
const schemaCategoryByLabel: Record<string, string> = {
  "Developer Tools": "DeveloperApplication",
  "Data Tools": "UtilitiesApplication",
  "Image / Inspection": "MultimediaApplication",
  "PDF Tools": "UtilitiesApplication",
  "YouTube / Data": "UtilitiesApplication",
};
const schemaApplicationCategory = schemaCategoryByLabel[category] ?? "UtilitiesApplication";
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name,
  applicationCategory: schemaApplicationCategory,
  operatingSystem: "Web browser",
  url: canonicalUrl,
  description: pageDesc,
  isAccessibleForFree: true,
  featureList: features,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: siteConfig.name, url: siteConfig.siteUrl },
};
const faqSchema = displayFaq.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: displayFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
} : null;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.siteUrl },
    { "@type": "ListItem", position: 2, name: "Tools", item: toCanonicalUrl("/apps") },
    { "@type": "ListItem", position: 3, name, item: canonicalUrl },
  ],
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalUrl} />
  {!indexable && <meta name="robots" content="noindex, follow" />}
  <link rel="icon" type="image/svg+xml"  href="/favicon.svg" />
  <link rel="icon" type="image/png"      href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/x-icon"   href="/favicon.ico" />
  <link rel="apple-touch-icon"           href="/apple-touch-icon.png" />
  <link rel="manifest"                   href="/site.webmanifest" />
  <meta name="theme-color" content="#1a73e8" />
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:image"       content={ogImageUrl} />
  <meta property="og:image:type"  content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImageUrl} />
  <ConsentMode />
  <AdSenseHead />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Anti-FOUC dark theme -->
  <script is:inline>
    (function(){
      var t = localStorage.getItem('swa-theme') ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet" />
</head>
<body>
  <Header />

  <div class="tool-page">
    <!-- ── Breadcrumb strip ── -->
    <div class="tl-strip">
      <div class="tl-strip-inner">
        <a href="/apps/" class="tl-back">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          All tools
        </a>
        <span class="tl-sep">›</span>
        <span class="tl-name">{name}</span>
        <span class={`tl-badge ${isLive ? "live" : "soon"}`}>● {isLive ? "Live" : "Coming soon"}</span>
        <span class="tl-cat">{category}</span>
        {disclaimer && (
          <span class="tl-disclaimer">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            {disclaimer}
          </span>
        )}
        <span class="tl-spacer"></span>
        <ContentInfoLink content={content} />
      </div>
    </div>

    <!-- ── Tool content ── -->
    <div class={fullWidth ? 'tl-body-full' : 'tl-body'}>
      <!-- Tool hero: title + the tool itself fill the fold; next section peeks below -->
      <section class="tl-hero">
        <div class="tl-hero-bg" aria-hidden="true"></div>
        <div class="tl-head">
          <h1 class="tl-title">{name}</h1>
          {description && <p class="tl-desc">{description}</p>}
        </div>
        <div class="tl-tool">
          <div class="tl-tool-chrome">
            <span class="tl-chrome-title">{name}</span>
            <span class="tl-chrome-badge">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Runs locally
            </span>
          </div>
          <div class="tl-tool-body">
            <div
              class="tl-stage"
              data-layout={layout}
              data-layout-width={layoutWidth}
              data-rail-first={layoutRailFirst ? "" : undefined}
              style={layoutRail ? `--tl-stage-rail: ${layoutRail}px` : undefined}
            >
              <slot />
            </div>
          </div>
        </div>
      </section>
      <!--
        Everything below the tool. One ad unit, two positions, no second
        <ins>: at >= 1440px this is a two-column grid and the rail is a
        sticky right column spanning both content rows; below that the grid
        becomes block flow and the rail lands where source order puts it —
        between the long-form content and the FAQ, exactly where the single
        slot used to sit. Rendering two units and hiding one by breakpoint
        would push into a display:none container, which never fills.

        Related links come after the FAQ so every piece of original content
        sits between the tool and the first link off the page.
      -->
      <div class="tl-lower">
        <div class="tl-lower-main">
          <ExpandedContent
            howToUse={content?.howToUse}
            useCases={content?.useCases}
            limitations={content?.limitations}
            privacy={content?.privacy}
            deepDive={content?.deepDive}
          />
        </div>
        <aside class="tl-rail"><AdSlot placement="tool-content" /></aside>
        <div class="tl-lower-tail">
          <ExpandedFaq items={displayFaq} />
          <slot name="related" />
        </div>
      </div>
    </div>
  </div>

  <Footer />
  <CookieBanner />
</body>
</html>

<style>
*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0; min-height: 100vh;
  background: var(--page-bg); color: var(--text);
  font-family: 'Inter', sans-serif;
}

.tool-page { display: flex; flex-direction: column; min-height: calc(100vh - 62px); }

/* Strip */
.tl-strip {
  background: var(--nav-bg); border-bottom: 1px solid var(--border);
  padding: 0 24px; flex-shrink: 0;
}
.tl-strip-inner {
  max-width: 1280px; margin: 0 auto;
  height: 44px; display: flex; align-items: center; gap: 8px;
  overflow: hidden;
}
.tl-back {
  display: flex; align-items: center; gap: 5px;
  font-size: .78rem; font-weight: 500; color: var(--muted);
  text-decoration: none; white-space: nowrap; flex-shrink: 0;
  transition: color .15s;
}
.tl-back:hover { color: var(--blue); }
.tl-sep { color: var(--muted); opacity: .4; font-size: .8rem; flex-shrink: 0; }
.tl-name { font-size: .86rem; font-weight: 700; color: var(--text); white-space: nowrap; flex-shrink: 0; }
.tl-badge {
  font-size: .65rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; flex-shrink: 0;
}
.tl-badge.live { background: #dcfce7; color: #15803d; }
.tl-badge.soon { background: #fef3c7; color: #92400e; }
[data-theme="dark"] .tl-badge.live { background: rgba(34,197,94,.15); color: #86efac; }
[data-theme="dark"] .tl-badge.soon { background: rgba(245,158,11,.15); color: #fde68a; }
.tl-cat {
  font-size: .74rem; color: var(--muted); opacity: .7;
  white-space: nowrap; flex-shrink: 0;
}
.tl-disclaimer {
  display: flex; align-items: center; gap: 4px;
  font-size: .72rem; color: #f59e0b; font-style: italic;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tl-spacer { flex: 1; }

/* Body */
.tl-body {
  --tl-gutter: 24px;
  --tl-pad-top: 32px;
  --tl-rail-w: 300px;
  flex: 1;
  max-width: 1280px; width: 100%; margin: 0 auto;
  padding: var(--tl-pad-top) var(--tl-gutter) 64px;
}

/* ── Below the tool: content column, and on wide screens a sticky ad rail ──
      Under 1440px this is plain block flow, so the rail renders in source
      order (after the long-form content, before the FAQ) — the position the
      single slot already had. The grid only turns on where there is room for
      it, and the container grows by exactly as much as the rail costs, so no
      column gets narrower than it is today. */
@media (min-width: 1440px) {
  .tl-body { max-width: 1560px; }
  .tl-lower {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--tl-rail-w);
    column-gap: 32px;
    align-items: start;
  }
  .tl-lower-main { grid-column: 1; grid-row: 1; min-width: 0; }
  .tl-lower-tail { grid-column: 1; grid-row: 2; min-width: 0; }
  .tl-rail {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: sticky;
    /* the site header is sticky at 62px; this clears it with air to spare */
    top: 80px;
    /* line the rail up with the first section's top rule */
    margin-top: 48px;
  }
  /* AdSlot ships its own inline (unscoped) CSS sized for a full-width block.
     In the rail it is a 300px column, so those three values are overridden
     here rather than branched inside the component. */
  .tl-rail :global(.ad-slot) {
    max-width: var(--tl-rail-w);
    margin: 0;
    padding: 0;
    min-height: 600px;
  }
  .tl-rail :global(.ad-slot .adsbygoogle) { min-height: 600px; }
}
.tl-body-full {
  --tl-gutter: 0px;
  --tl-pad-top: 32px;
  flex: 1; width: 100%;
  padding: var(--tl-pad-top) var(--tl-gutter) 64px;
}

/* ── Tool hero: fills ~80% of the viewport so the tool is the main content
      and the next section peeks below the fold ── */
.tl-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  /* 80vh minus navbar (62px) + breadcrumb strip (44px) + body top padding */
  min-height: calc(80vh - 138px);
  min-height: calc(80svh - 138px);
}
.tl-hero-bg {
  position: absolute;
  /* Bleed out to the body padding edge only. A hardcoded inset overshoots
     once the gutter shrinks at <= 640px and the page scrolls sideways. */
  inset: calc(-1 * var(--tl-pad-top)) calc(-1 * var(--tl-gutter)) 0;
  pointer-events: none;
  background-image: radial-gradient(color-mix(in srgb, var(--text) 8%, transparent) 1.2px, transparent 1.2px);
  background-size: 26px 26px;
  -webkit-mask-image: radial-gradient(ellipse 85% 60% at 50% 0%, black 15%, transparent 68%);
  mask-image: radial-gradient(ellipse 85% 60% at 50% 0%, black 15%, transparent 68%);
}
/* ── The tool as an "app window": chrome bar + tinted stage body ── */
.tl-tool {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  border: 1.5px solid var(--card-border);
  border-radius: 20px;
  background: var(--card-bg);
  box-shadow: 0 28px 60px -28px rgba(15, 23, 42, .22), 0 2px 10px rgba(15, 23, 42, .05);
  overflow: hidden;
}
[data-theme="dark"] .tl-tool {
  box-shadow: 0 28px 60px -28px rgba(0, 0, 0, .6), 0 2px 10px rgba(0, 0, 0, .3);
}

.tl-tool-chrome {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 11px 16px;
  background: var(--drop-header-bg);
  border-bottom: 1px solid var(--card-border);
  flex-shrink: 0;
}
.tl-chrome-title {
  flex: 1;
  text-align: left;
  font-size: .74rem;
  font-weight: 600;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0;
}
.tl-chrome-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
  font-size: .67rem;
  font-weight: 700;
  color: #16a34a;
  background: rgba(34, 197, 94, .1);
  padding: 3px 10px;
  border-radius: 20px;
  white-space: nowrap;
}
[data-theme="dark"] .tl-chrome-badge { color: #86efac; background: rgba(34, 197, 94, .13); }

.tl-tool-body {
  flex: 1;
  min-width: 0;
  padding: clamp(16px, 2.5vw, 28px);
  background:
    radial-gradient(100% 90% at 50% 0%, color-mix(in srgb, var(--blue) 5%, transparent), transparent 65%),
    var(--bg);
}

/* ── Stage layouts ──
      A tool names one in apps.ts and the shell owns the arrangement, so the
      component renders its sections and nothing else. Two spellings of the
      same vertical run (`grid gap-5` and `flex flex-col gap-5`) lived side by
      side across the tools; this is the single one. A tool with no layout
      keeps its own root wrapper and nothing here applies to it — that is what
      makes the migration safe to do in batches. */
.tl-stage { min-width: 0; }

/* `intake` arranges itself exactly like `stack` — a vertical run of sections.
   It keeps its own name because what it declares is what the tool DOES (a file
   goes in), not how wide its columns are, and that is what the intake-specific
   copy and affordances hang off later. */
.tl-stage[data-layout="stack"],
.tl-stage[data-layout="intake"],
.tl-stage[data-layout="intake-split"] {
  display: grid;
  gap: 20px;
  align-content: start;
}

.tl-stage[data-layout="split"],
.tl-stage[data-layout="split-rail"] {
  display: grid;
  gap: 20px;
  align-content: start;
}

/* `intake-split` puts the intake and its controls beside the result, and the
   result side gets the extra room. One ratio, not one per tool: the three that
   split at the root had drifted to 0.95fr/1.05fr, 0.85fr/1.15fr and a fixed
   280px rail, which is drift, not design. Below md it collapses to the same
   vertical run as `intake` — a dropzone next to a result pane at phone width
   gives you two things too narrow to use. */
@media (min-width: 768px) {
  .tl-stage[data-layout="intake-split"] {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
  }
  /* `split` is the genuinely proportional pair — input beside result. The
     roots said grid-cols-2, [1fr_0.9fr] and a bare flex-row, which are all
     "about half each"; this is that, said once. */
  .tl-stage[data-layout="split"] {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
  }
}

/* `split-rail` is the other shape the roots revealed: one workspace beside a
   narrow fixed rail of controls or a summary. The rail width is the tool's to
   declare (--tl-rail-px, set from layoutRail) because a swatch column and an
   SEO report are not the same object; what the shell fixes is the breakpoint,
   the gap and the alignment. It waits for lg — a 320px rail beside a workspace
   needs more room than a proportional pair does. */
.tl-stage[data-layout="split-rail"] { --tl-stage-rail: 320px; }
@media (min-width: 1024px) {
  .tl-stage[data-layout="split-rail"] {
    grid-template-columns: minmax(0, 1fr) var(--tl-stage-rail);
    align-items: start;
  }
  .tl-stage[data-layout="split-rail"][data-rail-first] {
    grid-template-columns: var(--tl-stage-rail) minmax(0, 1fr);
  }
}
/* Same rem values as the Tailwind caps they replace. */
.tl-stage[data-layout-width="md"] { max-width: 28rem; margin-inline: auto; }
.tl-stage[data-layout-width="lg"] { max-width: 32rem; margin-inline: auto; }
.tl-stage[data-layout-width="xl"] { max-width: 36rem; margin-inline: auto; }
.tl-stage[data-layout-width="5xl"] { max-width: 64rem; margin-inline: auto; }

.tl-head { position: relative; margin-bottom: 20px; }
.tl-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: var(--text);
}
.tl-desc {
  margin: 8px 0 0;
  max-width: 760px;
  font-size: .92rem;
  line-height: 1.65;
  color: var(--muted);
}
.tl-body-full .tl-head { padding: 0 24px; }

@media (max-width: 640px) {
  .tl-cat, .tl-sep { display: none; }
  .tl-body, .tl-body-full {
    --tl-gutter: 16px;
    --tl-pad-top: 16px;
    padding: var(--tl-pad-top) var(--tl-gutter) 48px;
  }
  .tl-body-full .tl-head { padding: 0 16px; }
  .tl-tool { border-radius: 16px; }
  .tl-tool-chrome { padding: 9px 12px; }
  /* The title used to be hidden here because the traffic lights already
     filled the bar. With those gone it is the only thing naming the tool,
     so it stays and the badge keeps its place at the right. */
  .tl-chrome-badge { margin-left: auto; }
  .tl-tool-body { padding: 12px; }
}
</style>
