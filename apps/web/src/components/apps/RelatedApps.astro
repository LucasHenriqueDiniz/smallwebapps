---
import type { AppDefinition } from "@smallwebapps/data";

interface Props {
  items: AppDefinition[];
  title?: string;
  eyebrow?: string;
  viewAllHref?: string;
}

const {
  items,
  title = "Similar tools",
  eyebrow = "Related tools",
  viewAllHref = "/apps",
} = Astro.props;
---

{items.length > 0 && (
<section class="related-tools">
  <div class="related-head">
    <div>
      <span>{eyebrow}</span>
      <h2>{title}</h2>
    </div>
    <a href={viewAllHref}>See all tools →</a>
  </div>

  <div class="related-grid">
    {
      items.map((item) => (
        <a href={item.landingUrl} class="related-card">
          <div class="related-meta">
            <span>{item.status === "live" ? "Live" : "Soon"}</span>
            <small>{item.category}</small>
          </div>
          <h3>{item.name}</h3>
          <p>{item.shortDescription}</p>
          <div class="related-tags">
            {item.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
          </div>
        </a>
      ))
    }
  </div>
</section>
)}

<style>
.related-tools {
  margin-top: 48px;
  border-top: 1px solid var(--border);
  padding-top: 40px;
}

.related-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.related-head span {
  display: block;
  color: var(--accent);
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.related-head h2 {
  color: var(--text);
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.01em;
  line-height: 1.3;
}

.related-head a {
  color: var(--blue);
  flex-shrink: 0;
  font-size: .84rem;
  font-weight: 700;
  text-decoration: none;
  transition: opacity .2s ease;
}
.related-head a:hover { opacity: .7; }

.related-grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.related-card {
  border: 1.5px solid var(--card-border);
  border-radius: 14px;
  background: var(--card-bg);
  color: inherit;
  min-width: 0;
  padding: 16px;
  text-decoration: none;
  transition: border-color .3s ease, transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s ease;
}

.related-card:hover {
  border-color: var(--blue);
  box-shadow: 0 10px 24px rgba(26, 115, 232, .1);
  transform: translateY(-3px);
}

.related-meta {
  align-items: center;
  display: flex;
  gap: 8px;
  justify-content: space-between;
  min-width: 0;
}

.related-meta span {
  background: #dcfce7;
  border-radius: 999px;
  color: #15803d;
  flex-shrink: 0;
  font-size: .62rem;
  font-weight: 800;
  padding: 3px 8px;
  text-transform: uppercase;
}

.related-meta small {
  color: var(--muted);
  font-size: .7rem;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-card h3 {
  color: var(--text);
  font-size: .95rem;
  font-weight: 800;
  line-height: 1.25;
  margin: 12px 0 0;
}

.related-card p {
  color: var(--muted);
  display: -webkit-box;
  font-size: .78rem;
  line-height: 1.45;
  margin: 7px 0 0;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.related-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 12px;
}

.related-tags span {
  background: var(--input-bg);
  border: 1px solid var(--border);
  border-radius: 999px;
  color: var(--muted);
  font-size: .68rem;
  font-weight: 700;
  padding: 4px 8px;
}

:global([data-theme="dark"]) .related-meta span {
  background: rgba(34, 197, 94, .15);
  color: #86efac;
}

@media (max-width: 860px) {
  .related-grid { grid-template-columns: 1fr; }
  .related-head { align-items: flex-start; flex-direction: column; }
}
</style>
