---
import type { GuideDefinition } from "@/data/guides";

interface Props {
  items: GuideDefinition[];
  title?: string;
  eyebrow?: string;
  viewAllHref?: string;
}

const {
  items,
  title = "Related guides",
  eyebrow = "Keep reading",
  viewAllHref = "/guides/",
} = Astro.props;
---

{items.length > 0 && (
<section class="related-guides">
  <div class="related-guides-head">
    <div>
      <span>{eyebrow}</span>
      <h2>{title}</h2>
    </div>
    <a href={viewAllHref}>See all guides →</a>
  </div>

  <ul class="related-guides-list">
    {
      items.map((guide) => (
        <li>
          <a href={`/guides/${guide.slug}/`} class="related-guide">
            <small>{guide.category}</small>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
)}

<style>
.related-guides {
  margin-top: 48px;
  border-top: 1px solid var(--border);
  padding-top: 40px;
}

.related-guides-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.related-guides-head span {
  display: block;
  color: var(--accent);
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.related-guides-head h2 {
  color: var(--text);
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.01em;
  line-height: 1.3;
}

.related-guides-head a {
  color: var(--blue);
  flex-shrink: 0;
  font-size: .84rem;
  font-weight: 700;
  text-decoration: none;
  transition: opacity .2s ease;
}
.related-guides-head a:hover { opacity: .7; }

.related-guides-list {
  display: grid;
  gap: 12px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.related-guide {
  border: 1.5px solid var(--card-border);
  border-radius: 14px;
  background: var(--card-bg);
  color: inherit;
  display: block;
  min-width: 0;
  padding: 16px;
  text-decoration: none;
  transition: border-color .3s ease, transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s ease;
}

.related-guide:hover {
  border-color: var(--blue);
  box-shadow: 0 10px 24px rgba(26, 115, 232, .1);
  transform: translateY(-3px);
}

.related-guide small {
  color: var(--muted);
  display: block;
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.related-guide h3 {
  color: var(--text);
  font-size: .95rem;
  font-weight: 800;
  line-height: 1.3;
  margin: 8px 0 0;
}

.related-guide p {
  color: var(--muted);
  display: -webkit-box;
  font-size: .78rem;
  line-height: 1.5;
  margin: 6px 0 0;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

@media (max-width: 860px) {
  .related-guides-head { align-items: flex-start; flex-direction: column; }
}
</style>
