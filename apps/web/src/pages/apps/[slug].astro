---
import ToolLayout from "@/components/layout/ToolLayout.astro";
import ToolMount from "@/components/tools/ToolMount.astro";
import RelatedApps from "@/components/apps/RelatedApps.astro";
import RelatedGuides from "@/components/guides/RelatedGuides.astro";
import { apps, appMap } from "@/data/apps";
import { guidesForTool } from "@/data/guides";
import { listedCategories } from "@/data/listed";
import { relatedTools } from "@/lib/related";
import { categoryPath } from "@/lib/urls";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug } }));
}

const app = appMap[Astro.params.slug ?? ""];
if (!app) throw new Error(`Unknown app slug: ${Astro.params.slug}`);

const relatedApps = relatedTools(app, apps);

// A tool outside the listed categories (Developer, Data) is reachable only by
// URL. Its related block can only offer tools from elsewhere, so it says so,
// and "view all" goes to the index rather than to a category nothing lists.
const relatedInCategory = relatedApps.every((item) => item.category === app.category);
const categoryHref = listedCategories.includes(app.category) ? categoryPath(app.category) : "/apps/";

/**
 * Category labels are a mix: some already end in "Tools" ("Data Tools"), some
 * do not ("Image / Inspection"). Interpolating the raw label into
 * `More ${category} tools` produced "More Data Tools tools" on the 110 pages
 * whose category carries the suffix. Drop it and name the category instead.
 */
const categoryShortLabel = app.category.replace(/\s+Tools$/i, "");

const toolGuides = guidesForTool(app.slug);
---

<ToolLayout
  name={app.name}
  category={app.category}
  status={app.status}
  slug={app.slug}
  disclaimer={app.disclaimer}
  layout={app.layout}
  layoutWidth={app.layoutWidth}
  layoutRail={app.layoutRail}
  layoutRailFirst={app.layoutRailFirst}
  seoTitle={app.seo.title}
  seoDescription={app.seo.description}
  description={app.longDescription}
  features={app.features}
  faq={app.faq}
  faqExpanded={app.faqExpanded}
  content={app.content}
>
  <ToolMount slug={app.slug} />
  <RelatedGuides
    slot="related"
    items={toolGuides}
    title="Guides for this tool"
    eyebrow="Read next"
  />
  <RelatedApps
    slot="related"
    items={relatedApps}
    title={relatedInCategory ? `More tools in ${categoryShortLabel}` : "Other tools on this site"}
    eyebrow="Related tools"
    viewAllHref={categoryHref}
  />
</ToolLayout>
