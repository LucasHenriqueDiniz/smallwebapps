# Build-time configuration for apps/web. Copy to `.env` for local work, or set
# these in the Cloudflare Pages project (Settings > Environment variables).
#
# Every value here is public: Astro inlines PUBLIC_* variables into the built
# HTML, and the AdSense publisher ID is already public in `public/ads.txt`.
# Nothing secret belongs in this file.

# ── AdSense ───────────────────────────────────────────────────────────────────
# Publisher ID, from the AdSense console (Account > Settings > Account
# information). Optional: src/components/site/AdSenseHead.astro falls back to
# the ID in public/ads.txt, so an unset value cannot silently drop the loader.
PUBLIC_ADSENSE_CLIENT=ca-pub-2600827684802809

# Ad unit IDs, from AdSense > Ads > By ad unit. These are the numeric
# `data-ad-slot` values, one per unit you create.
#
# Leave them unset and src/components/site/AdSlot.astro renders nothing at all —
# no <ins>, no push() — so the pages ship exactly as they do today. Fill them in
# and the two units appear:
#
#   TOOL_CONTENT  — on a tool page, below the tool, the related links and the
#                   long-form content, above the FAQ.
#   HOME_LISTING  — on the home page, between the "popular" and "featured"
#                   listing sections.
#
# Both sit outside the core tool workflow, which CLAUDE.md requires.
# PUBLIC_ADSENSE_SLOT_TOOL_CONTENT=
# PUBLIC_ADSENSE_SLOT_HOME_LISTING=

# Kill switch. Set to "true" on any deployment that must not request ads.
# It is normally not needed: ads are already off in `pnpm dev`, off on
# Cloudflare Pages preview branches (detected through CF_PAGES_BRANCH), off on
# the 404 page and off on every noindex page. See src/lib/ads.ts.
# PUBLIC_ADSENSE_DISABLED=true
